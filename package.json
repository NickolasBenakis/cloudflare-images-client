{
	"name": "cloudflare-images-client",
	"version": "1.2.1",
	"description": "Complete wrapper around cloudflare images api",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"dev": "tsc src/index.ts",
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:contract": "vitest run tests/contract.test.ts",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"lint": "biome ci .",
		"format": "biome check --write .",
		"check:package": "node scripts/smoke.mjs && publint && attw --pack .",
		"check:workers": "esbuild dist/index.js --bundle --platform=browser --conditions=workerd,worker,browser --format=esm --log-level=warning > /dev/null",
		"openapi:update": "node scripts/openapi-update.mjs",
		"prepublishOnly": "npm run build && npm test && npm run check:package && npm run check:workers"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@biomejs/biome": "^2.6.5",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"ajv": "^8.20.0",
		"ajv-formats": "^3.0.1",
		"dotenv": "^18.0.9",
		"esbuild": "^0.28.2",
		"msw": "^3.0.3",
		"publint": "^0.3.25",
		"tsup": "^9.0.0",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NickolasBenakis/cloudflare-images-client.git"
	},
	"author": "Nikos Benakis <nickolasbenele@gmail.com>",
	"contributors": [
		{
			"name": "Nikos Benakis",
			"email": "nickolasbenele@gmail.com",
			"url": "https://github.com/NickolasBenakis"
		},
		{
			"name": "Dimitris Pattas",
			"email": "dimitris.pattas.dev@gmail.com",
			"url": "https://github.com/DimitrisPattas"
		}
	],
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/NickolasBenakis/cloudflare-images-client/issues"
	},
	"homepage": "https://github.com/NickolasBenakis/cloudflare-images-client#readme",
	"keywords": [
		"cloudflare",
		"Cloudflare",
		"Cloudflare Images",
		"API Client",
		"Assets",
		"Cloudflare Workers"
	]
}
