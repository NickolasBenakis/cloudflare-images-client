	"info": {
		"title": "Cloudflare Images (subset used by cloudflare-images-client)",
		"version": "4.0.0",
		"x-source": "https://raw.githubusercontent.com/cloudflare/api-schemas/main/openapi.json"
	},
	"openapi": "3.0.3",
	"paths": {
		"/accounts/{account_id}/images/v1": {
			"post": {
