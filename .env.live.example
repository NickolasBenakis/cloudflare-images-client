# Copy to .env.live (git-ignored) and fill in. Used only by `npm run smoke:live`.
# Account ID: dashboard → any zone's Overview sidebar, or Workers & Pages.
CLOUDFLARE_ACCOUNT_ID=
# API token with "Account → Cloudflare Images → Edit". Create at
# https://dash.cloudflare.com/profile/api-tokens and delete it after the run.
CLOUDFLARE_API_TOKEN=
# Optional: a signing key (Images → Keys). Fetched via the API if empty.
CLOUDFLARE_IMAGES_SIGNING_KEY=
